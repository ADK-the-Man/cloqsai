# ============================================================
# CloudCost Architect AI — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Required ---
# PostgreSQL connection string (used by backend)
DATABASE_URL=postgresql+asyncpg://cloudcost:cloudcost_dev@localhost:5432/cloudcost_db

# JWT secret key — must be at least 32 characters, use a random string
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_32_char_secret_key_here

# --- AI Provider (Required for AI features) ---
# Anthropic API key — get from https://console.anthropic.com or your OpenAI/Anthropic gateway
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
# Optional custom gateway base URL (e.g. https://api.ai.kodekloud.com/v1 or https://api.anthropic.com/v1)
ANTHROPIC_BASE_URL=https://api.ai.kodekloud.com/v1
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Demo User (Simplified Auth) ---
DEMO_EMAIL=demo@cloudcost.ai
DEMO_PASSWORD=changeme123

# --- Social & Browser Login Toggle ---
# Set to 'false' (default): fall back to only credentials login (no register, no social buttons)
# Set to 'true': enables browser login with Gmail (Google), Outlook (Microsoft), etc.
LOGIN_ENABLED=false

# Optional: OAuth 2.0 Client credentials (if unset when LOGIN_ENABLED=true, seamless one-click browser SSO is used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- AWS MCP Sidecar ---
# URL of the AWS Pricing Calculator MCP server (runs as Docker sidecar)
AWS_MCP_URL=http://aws-mcp-sidecar:8000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- Application ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Artifact storage directory (inside container)
ARTIFACTS_DIR=/app/artifacts

# --- Optional: Redis (for future use) ---
# REDIS_URL=redis://localhost:6379/0

# --- Optional: Azure ---
# Azure pricing uses the public Retail Prices API — no credentials required
# Azure calculator Playwright automation (optional, requires browser)
# AZURE_CALCULATOR_URL=https://azure.microsoft.com/pricing/calculator/

# --- Optional: Override AWS MCP save endpoint (testing only) ---
# AWS_SAVE_URL=

# --- Playwright ---
# Set to 1 to run browsers in headless mode (recommended for Docker)
PLAYWRIGHT_HEADLESS=1
